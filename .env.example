PORT=3000
NODE_ENV=development
SESSION_SECRET=replace-with-a-long-random-secret
DATABASE_FILE=./data.sqlite

# Get a key from your market-data provider. Keep it on the server, never in public JS.
TWELVE_DATA_API_KEY=
TWELVE_DATA_BASE_URL=https://api.twelvedata.com

# First-run admin account is created if it does not exist yet.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeThis-Immediately-123!

# OTC is deliberately disabled unless you implement and verify a licensed, compatible
# provider for the exact OTC feed. Do not point this at an unrelated forex feed.
OTC_PROVIDER_CONFIGURED=false
